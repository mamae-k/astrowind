---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AcquireLift | Google Ad Grant Specialist',
  description: 'Certified Google Partner helping nonprofits audit, optimize, and manage their $10,000/month Google Ad Grant. Free account audits delivered in 24-48 hours.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Section 1: Hero -->
  <section id="hero" class="relative bg-[#10243E] text-white py-20 lg:py-28 overflow-hidden">
    <div class="container mx-auto px-4 relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur rounded-full px-4 py-2 text-sm mb-6 border border-white/10">
        <span class="w-2 h-2 bg-[#10B981] rounded-full animate-pulse"></span>
        Available for New Clients · Certified Google Partner
      </div>

      <!-- Headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight max-w-4xl">
        I Help Nonprofits Turn Their 
        <span class="text-[#10B981]">$10,000/Month Grant</span> 
        Into Real, Measurable Impact.
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-lg md:text-xl text-slate-300 max-w-2xl">
        Most nonprofits <strong class="text-white">waste or lose their Google Ad Grant</strong> due to policy violations, low Quality Scores, and poor account structure. I fix that — and I have the results to prove it.
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#contact" class="bg-[#10B981] hover:bg-[#059669] text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors shadow-lg shadow-[#10B981]/20">
          Book Your Free Audit
        </a>
        <a href="#case-studies" class="border-2 border-white/30 text-white hover:bg-white/10 px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
          View Case Studies →
        </a>
      </div>

      <!-- Trust Bar -->
      <div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-slate-400">
        <span class="text-[#10B981]">★★★★★</span> 5.0 on Upwork
        <span class="hidden md:inline">·</span>
        Certified Google Partner
        <span class="hidden md:inline">·</span>
        40+ accounts managed
      </div>

      <!-- Google Partner Badge -->
      <div class="mt-6">
        <a href="https://www.google.com/partners/agency?id=6835380641" target="_blank" rel="noopener noreferrer" class="inline-block hover:opacity-90 transition-opacity">
          <img src="https://www.gstatic.com/partners/badge/images/2025/PartnerBadgeClickable.svg" alt="Google Partner" class="h-16" />
        </a>
      </div>
    </div>

    <!-- Floating Stats (decorative, right side on desktop) -->
    <div class="hidden lg:block absolute right-8 top-1/2 -translate-y-1/2 space-y-4 max-w-xs">
      <div class="bg-white/10 backdrop-blur rounded-xl p-4 border border-white/10 shadow-xl">
        <div class="text-[#10B981] text-2xl font-bold">1,200%</div>
        <div class="text-xs text-slate-300">Traffic increase — Case Study #1</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-xl p-4 border border-white/10 shadow-xl">
        <div class="text-[#10B981] text-2xl font-bold">8.0/10</div>
        <div class="text-xs text-slate-300">Avg. Quality Score achieved</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-xl p-4 border border-white/10 shadow-xl">
        <div class="text-[#10B981] text-2xl font-bold">65%</div>
        <div class="text-xs text-slate-300">More high-value goal completions</div>
      </div>
    </div>
  </section>

  <!-- Section 2: Stats Bar -->
  <section id="stats" class="bg-[#F8FAFC] py-12 border-b border-slate-200">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
          <div class="text-3xl md:text-4xl font-bold text-[#10243E]">40+</div>
          <div class="text-sm text-slate-600 mt-1">Nonprofit Accounts Managed</div>
        </div>
        <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
          <div class="text-3xl md:text-4xl font-bold text-[#10243E]">$10K</div>
          <div class="text-sm text-slate-600 mt-1">Monthly Grant Value Per Client</div>
        </div>
        <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
          <div class="text-3xl md:text-4xl font-bold text-[#10243E]">5%+</div>
          <div class="text-sm text-slate-600 mt-1">Avg. CTR (2× Google's requirement)</div>
        </div>
        <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
          <div class="text-3xl md:text-4xl font-bold text-[#10243E]">5.0 ★</div>
          <div class="text-sm text-slate-600 mt-1">Upwork Rating · Google Certified</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Services -->
  <section id="services" class="py-20 bg-[#F8FAFC]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">What I Do</span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#10243E] mt-2">Everything Your Grant Needs to Thrive</h2>
        <p class="text-slate-600 mt-4 max-w-2xl mx-auto">
          From compliance firefighting to long-term growth — I handle the full lifecycle of your Google Ad Grant so you can focus on your mission.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <!-- Service 1 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-[#10B981]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[#10B981] text-2xl">search</span>
          </div>
          <h3 class="text-xl font-bold text-[#10243E] mb-2">Grant Revitalization & Compliance Audit</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Comprehensive account review to diagnose and fix "Policy Issue" flags, keyword suspensions, and low Quality Scores. I restore suspended accounts and build a solid compliance foundation so you never lose the grant again.
          </p>
          <span class="inline-block mt-4 text-xs font-semibold bg-[#10B981]/10 text-[#10B981] px-3 py-1 rounded-full">Most Popular</span>
        </div>

        <!-- Service 2 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-[#10B981]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[#10B981] text-2xl">rocket_launch</span>
          </div>
          <h3 class="text-xl font-bold text-[#10243E] mb-2">Full-Service Grant Management</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            End-to-end management of Search and Performance Max campaigns — including keyword research, ad copywriting, bid strategy, negative keyword lists, and monthly performance reporting.
          </p>
          <span class="inline-block mt-4 text-xs font-semibold bg-blue-50 text-blue-600 px-3 py-1 rounded-full">Ongoing</span>
        </div>

        <!-- Service 3 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-[#10B981]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[#10B981] text-2xl">bar_chart</span>
          </div>
          <h3 class="text-xl font-bold text-[#10243E] mb-2">GA4 & GTM Conversion Tracking</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Robust Google Tag Manager and GA4 setups so you know exactly how many donations, volunteer applications, or newsletter subscribers your ads generate. No more flying blind.
          </p>
          <span class="inline-block mt-4 text-xs font-semibold bg-purple-50 text-purple-600 px-3 py-1 rounded-full">Data-Driven</span>
        </div>

        <!-- Service 4 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-[#10B981]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[#10B981] text-2xl">lightbulb</span>
          </div>
          <h3 class="text-xl font-bold text-[#10243E] mb-2">Nonprofit PPC Strategy & Consulting</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Need a second opinion or strategic roadmap? I offer consulting sessions for organizations that manage their own grant but want expert guidance on keyword strategy and campaign architecture.
          </p>
          <span class="inline-block mt-4 text-xs font-semibold bg-orange-50 text-orange-600 px-3 py-1 rounded-full">Advisory</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Case Studies -->
  <section id="case-studies" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">Proven Results</span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#10243E] mt-2">Real Nonprofits. Real Numbers.</h2>
      </div>

      <!-- Case Study 1 -->
      <div class="max-w-4xl mx-auto mb-12 bg-[#F8FAFC] rounded-2xl p-8 border border-slate-100 shadow-sm">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">3 → 40+ clicks/day</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">1,200% traffic lift</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">CTR &gt; 5%</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] mb-4">Case Study 01: From "Dormant" to High-Performance</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600">A nonprofit's Ad Grant account had been inactive for months due to complex policy issues and keyword suspensions. They were receiving fewer than <strong>3 clicks per day</strong>.</p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 space-y-1 list-disc list-inside">
              <li>Full compliance audit to resolve "Policy Issue" flags</li>
              <li>Restructured into tightly themed ad groups</li>
              <li>"High-Intent" keyword strategy targeting immediate help seekers</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 space-y-1 list-disc list-inside">
              <li>Scaled from 3 clicks to <strong>40+ clicks/day</strong> within 3 weeks</li>
              <li>CTR over <strong>5%</strong> — exceeding Google's requirement</li>
              <li>Account fully reinstated with growth trajectory established</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Case Study 2 -->
      <div class="max-w-4xl mx-auto mb-12 bg-[#F8FAFC] rounded-2xl p-8 border border-slate-100 shadow-sm">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">+65% high-value conversions</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">80/20 traffic insight</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Waste eliminated</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] mb-4">Case Study 02: Data-Driven Scaling with GTM</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600">The nonprofit was getting steady traffic, but had no idea whether visitors were donating, signing up for programs, or just browsing. They were <strong>"flying blind"</strong> with zero conversion data.</p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 space-y-1 list-disc list-inside">
              <li>Built robust GTM conversion tracking framework from scratch</li>
              <li>Configured custom events for donations, signups, and newsletter subs</li>
              <li>Paused low-value keywords, doubled down on converters</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 space-y-1 list-disc list-inside">
              <li>Discovered <strong>20% of traffic drove 80% of conversions</strong></li>
              <li>Reallocated budget to high-converting segments</li>
              <li>Increased high-value goal completions by <strong>65%</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Case Study 3 -->
      <div class="max-w-4xl mx-auto bg-[#F8FAFC] rounded-2xl p-8 border border-slate-100 shadow-sm">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Quality Score: 8/10 avg.</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">-30% cost per conversion</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Top ad positions</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] mb-4">Case Study 03: The Relevance Overhaul</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600">A nonprofit struggled with chronically <strong>low Quality Score</strong>, causing ads to rarely appear in top positions. Generic ad copy out of sync with landing pages was the core culprit.</p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 space-y-1 list-disc list-inside">
              <li>Rewrote all ad copy using Responsive Search Ads matched to user intent</li>
              <li>Landing page consultation to align content with search queries</li>
              <li>Focused on long-tail, mission-relevant keywords</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 space-y-1 list-disc list-inside">
              <li>Average Quality Score of <strong>8/10</strong> across the account</li>
              <li>Ads consistently in <strong>top 1-3 positions</strong></li>
              <li>Reduced Cost Per Conversion by <strong>30%</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="#contact" class="bg-[#10B981] hover:bg-[#059669] text-white px-8 py-4 rounded-lg font-semibold text-lg inline-block transition-colors shadow-lg shadow-[#10B981]/20">
          Get Your Free Account Audit →
        </a>
      </div>
    </div>
  </section>

  <!-- Section 5: Process -->
  <section id="process" class="py-20 bg-[#10243E] text-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">My Process</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2">A Clear System. Predictable Results.</h2>
        <p class="text-slate-400 mt-4 max-w-2xl mx-auto">
          Every engagement follows a proven 4-step framework built specifically for the Google Ad Grant environment.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div class="text-center">
          <div class="w-16 h-16 bg-[#10B981] rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 text-white shadow-lg shadow-[#10B981]/30">1</div>
          <h3 class="text-xl font-bold mb-2">Discovery & Audit</h3>
          <p class="text-slate-400 text-sm">I review your existing account (or build from scratch), identify all compliance gaps, and document a prioritized action plan.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#10B981] rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 text-white shadow-lg shadow-[#10B981]/30">2</div>
          <h3 class="text-xl font-bold mb-2">Account Restructure</h3>
          <p class="text-slate-400 text-sm">Rebuild campaign architecture with tightly themed ad groups, high-intent keywords, and compelling RSA ad copy.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#10B981] rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 text-white shadow-lg shadow-[#10B981]/30">3</div>
          <h3 class="text-xl font-bold mb-2">Tracking & Measurement</h3>
          <p class="text-slate-400 text-sm">Deploy GA4 + GTM conversion tracking so every donation click, volunteer form, and newsletter signup is measurable.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#10B981] rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 text-white shadow-lg shadow-[#10B981]/30">4</div>
          <h3 class="text-xl font-bold mb-2">Optimize & Scale</h3>
          <p class="text-slate-400 text-sm">Monthly analysis to cut waste, expand what works, and continuously grow your mission's reach.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: About -->
  <section id="about" class="py-20 bg-[#F8FAFC]">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
        <!-- Left: Illustration container -->
        <div class="bg-[#10243E] rounded-2xl p-12 text-center border border-slate-800 shadow-xl">
          <span class="material-symbols-outlined text-[#10B981] text-8xl">psychology</span>
          <p class="text-white/60 mt-4 text-sm">Analytical Mind. Mission-Driven Heart.</p>
        </div>

        <!-- Right: Content -->
        <div>
          <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">About Me</span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#10243E] mt-2">Analytical Mind. Mission-Driven Heart.</h2>
          <p class="text-slate-600 mt-4 leading-relaxed">
            My journey in digital marketing began with a simple mission: help the organizations that make the world a better place actually reach the people who need them. After earning my <strong>Google Ads Search Certification</strong>, I spent years volunteering for nonprofits — giving me an insider understanding of the unique challenges, constraints, and compliance requirements of the Google Ad Grant program.
          </p>
          <p class="text-slate-600 mt-4 leading-relaxed">
            Today I am a <strong>5.0-rated specialist on Upwork</strong> who has managed dozens of nonprofit accounts across the United States and globally. I don't just "manage ads" — I take complete ownership of your Grant project, treating every dollar of your $10,000/month budget as if it were my own.
          </p>

          <!-- Values -->
          <div class="grid grid-cols-3 gap-4 mt-8">
            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-slate-100">
              <span class="material-symbols-outlined text-[#10B981] text-2xl">zoom_out</span>
              <h4 class="font-semibold text-[#10243E] text-sm mt-2">Transparency</h4>
              <p class="text-xs text-slate-500 mt-1">You always know where your budget goes</p>
            </div>
            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-slate-100">
              <span class="material-symbols-outlined text-[#10B981] text-2xl">bar_chart_4_bars</span>
              <h4 class="font-semibold text-[#10243E] text-sm mt-2">Data-Driven</h4>
              <p class="text-xs text-slate-500 mt-1">Every decision backed by GA4</p>
            </div>
            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-slate-100">
              <span class="material-symbols-outlined text-[#10B981] text-2xl">handshake</span>
              <h4 class="font-semibold text-[#10243E] text-sm mt-2">Integrity</h4>
              <p class="text-xs text-slate-500 mt-1">Your grant treated like my own $10K</p>
            </div>
          </div>

          <!-- Certs -->
          <div class="mt-8 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg shadow-sm border border-slate-100">
              <span class="material-symbols-outlined text-[#10B981]">verified</span>
              <span class="text-sm font-semibold text-[#10243E]">Google Ads Search Certified</span>
            </div>
            <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg shadow-sm border border-slate-100">
              <span class="material-symbols-outlined text-[#10B981]">verified</span>
              <span class="text-sm font-semibold text-[#10243E]">Google Partner</span>
            </div>
            <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg shadow-sm border border-slate-100">
              <span class="text-[#10B981]">★★★★★</span>
              <span class="text-sm font-semibold text-[#10243E]">Upwork 5.0 · 40+ contracts</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Testimonials -->
  <section id="testimonials" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">Client Feedback</span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#10243E] mt-2">What Nonprofits Say</h2>
        <p class="text-slate-500 mt-2 text-sm">Actual results from real organizations.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-[#F8FAFC] rounded-2xl p-8 border border-slate-100 shadow-sm">
          <div class="text-4xl text-[#10B981] mb-4">"</div>
          <p class="text-slate-700 text-sm leading-relaxed mb-6">
            Mamae completely transformed our dormant Ad Grant account. Within three weeks our daily clicks went from near zero to over 40. The compliance issues that had plagued us for months were resolved methodically and professionally.
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-[#10243E] rounded-full flex items-center justify-center">
              <span class="material-symbols-outlined text-white text-sm">account_balance</span>
            </div>
            <div>
              <div class="font-semibold text-[#10243E] text-sm">Executive Director</div>
              <div class="text-xs text-slate-500">U.S.-Based Nonprofit Organization</div>
              <div class="text-[#10B981] text-xs">★★★★★</div>
            </div>
          </div>
        </div>

        <div class="bg-[#F8FAFC] rounded-2xl p-8 border border-slate-100 shadow-sm">
          <div class="text-4xl text-[#10B981] mb-4">"</div>
          <p class="text-slate-700 text-sm leading-relaxed mb-6">
