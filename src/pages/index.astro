        <!-- AJAX JAVASCRIPT SUBMISSION -->
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('audit-form');
            const banner = document.getElementById('success-banner');
            const btn = document.getElementById('submit-btn');

            if (!form || !banner || !btn) {
              return;
            }

            form.addEventListener('submit', async (e) => {

              e.preventDefault();
              btn.textContent = 'Sending Audit Request...';
              btn.disabled = true;

              const formData = new FormData(form);

              try {
                const response = await fetch('https://api.staticforms.xyz/submit', {
                  method: 'POST',
                  body: formData,
                  headers: {
                    // Some endpoints require a JSON body; StaticForms accepts form data.
                  }
                });

                if (response.ok) {
                  form.classList.add('hidden');
                  banner.classList.remove('hidden');
                } else {
                  alert('Submission error. Please try again or email AcquireLift@gmail.com directly.');
                  btn.textContent = '➢ Submit Audit Request';
                  btn.disabled = false;
                }
              } catch (error) {
                console.error(error);
                alert('Network error. Please try again or email AcquireLift@gmail.com directly.');
                btn.textContent = '➢ Submit Audit Request';
                btn.disabled = false;
              }
            });
          });
        </script>
