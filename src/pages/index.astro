---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'AcquireLift | Google Ad Grant Specialist',
  description:
    'Certified Google Partner helping nonprofits audit, optimize, and manage their $10,000/month Google Ad Grant. Free account audits delivered in 24-72 hours.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Section 1: Hero -->
  <Hero
    id="hero"
    tagline="Google Ad Grant support for nonprofits"
    actions={[
      {
        variant: 'primary',
        text: 'Request Your Free Audit',
        href: '#contact',
        icon: 'tabler:mail',
      },
      { text: 'Explore Resources →', href: '/resources' },
    ]}
  >
    <Fragment slot="title">
      I help nonprofits use their Google Ad Grant with <span class="text-primary dark:text-[#10B981]">less guesswork and more focus</span>.
    </Fragment>
  
    <Fragment slot="subtitle">
      Most nonprofits do not need a flashy strategy. They need a clear setup, a cleaner account, and a practical plan for the
      next steps.
    </Fragment>

    <Fragment slot="image">
      <div class="relative max-w-xl mx-auto">
        <div class="bg-[#10243E] text-white p-8 rounded-2xl border border-white/10 shadow-2xl space-y-6">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 bg-[#10B981] rounded-full animate-pulse"></span>
              <span class="font-semibold text-sm">Certified Google Partner Status</span>
            </div>
            <span class="text-xs bg-[#10B981]/20 text-[#10B981] font-semibold px-2.5 py-1 rounded-full">Active</span>
          </div>

          <div class="space-y-4 text-left">
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-[#10B981] text-2xl font-bold">1,200%</div>
              <div class="text-xs text-slate-300">Traffic increase — Case Study #1</div>
            </div>
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-[#10B981] text-2xl font-bold">8.0 / 10</div>
              <div class="text-xs text-slate-300">Avg. Quality Score achieved</div>
            </div>
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-[#10B981] text-2xl font-bold">+65%</div>
              <div class="text-xs text-slate-300">High-value goal completions</div>
            </div>
          </div>

          <div class="pt-2 flex items-center justify-between text-xs text-slate-400">
            <span>5.0 ★ Rating on Upwork</span>
            <span>40+ Nonprofit Accounts</span>
          </div>
        </div>
      </div>
    </Fragment>
  </Hero>

  <!-- Section 2: Stats Bar -->
  <Stats
    id="stats"
    stats={[
      { title: 'Nonprofit Accounts Supported', amount: '40+' },
      { title: 'Grant Value Per Client', amount: '$10K' },
      { title: 'Audit Turnaround', amount: '24–72 hrs' },
      { title: 'Support Style', amount: 'Text-first' },
    ]}
  />

  <!-- Section 3: Services -->
  <Features
    id="services"
    tagline="What I Do"
    title="A practical way to improve grant health, structure, and growth"
    subtitle="I focus on the parts that usually cause the most friction: account structure, tracking, compliance, and messaging that reflects the work your nonprofit actually does."
    items={[
      {
        title: 'Grant Revitalization & Compliance Review',
        description:
          'A clear review of your account setup, policy issues, and early structure so you know what needs attention first.',
        icon: 'tabler:search',
      },
      {
        title: 'Ongoing Grant Management',
        description:
          'Hands-on support with keyword reviews, search terms, ad copy, and account maintenance so the grant stays useful over time.',
        icon: 'tabler:rocket',
      },
      {
        title: 'GA4 & GTM Conversion Tracking',
        description:
          'Robust Google Tag Manager and GA4 setups so donations, volunteer forms, and other meaningful actions are measurable.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Practical PPC Strategy Support',
        description:
          'Guidance for teams that want help making better decisions without overcomplicating the process.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Section 4: Case Studies -->
  <section id="case-studies" class="py-20 bg-white dark:bg-[#10243E]/50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">Proven Results</span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#10243E] dark:text-white mt-2">
          A few stories from nonprofits that needed a clearer path.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
          Some organizations needed a full reset. Others just needed a simpler structure, better tracking, and a more useful account.
        </p>
      </div>

      <!-- Case Study 1 -->
      <div
        class="max-w-4xl mx-auto mb-12 bg-[#F8FAFC] dark:bg-[#10243E] rounded-2xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm"
      >
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">3 → 40+ clicks/day</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">1,200% traffic lift</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Cleaner account structure</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] dark:text-white mb-4">
          Case Study 01: When a dormant account starts working again
        </h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600 dark:text-slate-300">
              A nonprofit's Ad Grant account had been inactive for months due to complex policy issues and keyword
              suspensions. They were receiving fewer than <strong>3 clicks per day</strong>.
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Full compliance audit to resolve "Policy Issue" flags</li>
              <li>Restructured into tightly themed ad groups</li>
              <li>"High-Intent" keyword strategy targeting immediate help seekers</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Scaled from 3 clicks to <strong>40+ clicks/day</strong> within 3 weeks</li>
              <li>The account became easier to manage and more relevant to the audience</li>
              <li>Account fully reinstated with growth trajectory established</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Case Study 2 -->
      <div
        class="max-w-4xl mx-auto mb-12 bg-[#F8FAFC] dark:bg-[#10243E] rounded-2xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm"
      >
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full"
            >+65% high-value conversions</span
          >
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">80/20 traffic insight</span
          >
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Waste eliminated</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] dark:text-white mb-4">
          Case Study 02: Data-Driven Scaling with GTM
        </h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600 dark:text-slate-300">
              The nonprofit was getting steady traffic, but had no idea whether visitors were donating, signing up for
              programs, or just browsing. They were <strong>"flying blind"</strong> with zero conversion data.
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Built robust GTM conversion tracking framework from scratch</li>
              <li>Configured custom events for donations, signups, and newsletter subs</li>
              <li>Paused low-value keywords, doubled down on converters</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Discovered <strong>20% of traffic drove 80% of conversions</strong></li>
              <li>Reallocated budget to high-converting segments</li>
              <li>Increased high-value goal completions by <strong>65%</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Case Study 3 -->
      <div
        class="max-w-4xl mx-auto mb-12 bg-[#F8FAFC] dark:bg-[#10243E] rounded-2xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm"
      >
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full"
            >Quality Score: 8/10 avg.</span
          >
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full"
            >-30% cost per conversion</span
          >
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Top ad positions</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] dark:text-white mb-4">Case Study 03: The Relevance Overhaul</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600 dark:text-slate-300">
              A nonprofit struggled with chronically <strong>low Quality Score</strong>, causing ads to rarely appear in
              top positions. Generic ad copy out of sync with landing pages was the core culprit.
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Rewrote all ad copy using Responsive Search Ads matched to user intent</li>
              <li>Landing page consultation to align content with search queries</li>
              <li>Focused on long-tail, mission-relevant keywords</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Average Quality Score of <strong>8/10</strong> across the account</li>
              <li>Ads consistently in <strong>top 1-3 positions</strong></li>
              <li>Reduced Cost Per Conversion by <strong>30%</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Case Study 4 -->
      <div
        class="max-w-4xl mx-auto bg-[#F8FAFC] dark:bg-[#10243E] rounded-2xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm"
      >
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Less guesswork</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">Clearer reporting</span>
          <span class="text-xs font-semibold bg-[#10B981] text-white px-3 py-1 rounded-full">More relevant traffic</span>
        </div>
        <h3 class="text-2xl font-bold text-[#10243E] dark:text-white mb-4">
          Case Study 04: A small team that needed the grant to feel manageable
        </h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h4 class="font-semibold text-red-600 mb-2">⚠ Challenge</h4>
            <p class="text-sm text-slate-600 dark:text-slate-300">
              The nonprofit was not trying to build a complicated advertising machine. They had a small team, limited time,
              and a grant account that was active but hard to interpret.
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-amber-600 mb-2">⚡ Strategy</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>Simplified the campaign structure around the organization’s core services</li>
              <li>Removed low-value themes and tightened the message around real user intent</li>
              <li>Set up tracking so the team could see what mattered without reading through endless reports</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-[#10B981] mb-2">✓ Result</h4>
            <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc list-inside">
              <li>The account became easier to review and easier to explain to leadership</li>
              <li>Traffic became more relevant to the work the organization actually does</li>
              <li>The team had a clearer path for the next improvement instead of constant guesswork</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Process -->
  <Steps
    id="process"
    title="My Process — A Clear System, Predictable Results"
    tagline="4-Step Framework"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Discovery & Audit</span>',
        description:
          'I review your existing account (or build from scratch), identify all compliance gaps, and document a prioritized action plan.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: <span class="font-medium">Account Restructure</span>',
        description:
          'Rebuild campaign architecture with tightly themed ad groups, high-intent keywords, and compelling RSA ad copy.',
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Step 3: <span class="font-medium">Tracking & Measurement</span>',
        description:
          'Deploy GA4 + GTM conversion tracking so every donation click, volunteer form, and newsletter signup is measurable.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Step 4: <span class="font-medium">Optimize & Scale</span>',
        description: 'Monthly analysis to cut waste, expand what works, and continuously grow your mission’s reach.',
        icon: 'tabler:trending-up',
      },
    ]}
  />

  <!-- Section 6: About & Credibility -->
  <Features2
    id="about"
    title="Analytical Mind. Mission-Driven Heart."
    subtitle="Certified Google Partner & 5.0-Rated Specialist on Upwork with 40+ managed nonprofit accounts."
    tagline="About AcquireLift"
    columns={3}
    items={[
      {
        title: 'Transparency',
        description: 'You always know where your budget goes. Clear monthly text & data reporting with zero fluff.',
        icon: 'tabler:eye',
      },
      {
        title: 'Data-Driven',
        description: 'Every decision backed by GA4 analytics, user conversion intent, and tight keyword architecture.',
        icon: 'tabler:chart-pie',
      },
      {
        title: 'Integrity',
        description: 'Your grant treated with the exact care as if it were my own $10,000 monthly marketing budget.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Section 7: Organic Blog & Content Showcase (The Core Engine) -->
  <BlogLatestPosts
    id="blog"
    title="Resources for Nonprofits Building Grant-Ready Websites and Stronger Ad Accounts"
    information="Explore practical guidance on Google Ad Grants, grant-ready websites, compliance, and conversion tracking so your content works as a real authority hub—not just a blog."
  />

  <!-- Section 8: FAQs -->
  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about Google Ad Grant compliance, audit turnaround, and management."
    tagline="Got Questions?"
    items={[
      {
        title: 'What is the Google Ad Grant for nonprofits?',
        description:
          'The Google Ad Grant provides eligible 501(c)(3) nonprofits with up to $10,000 USD per month in free Google Search advertising budget. It allows organizations to promote programs, attract volunteers, and drive donations free of charge.',
      },
      {
        title: 'Why did my Google Ad Grant account get suspended?',
        description:
          'Common causes include policy issues, weak keyword structure, missing conversion tracking, weak landing page relevance, or account settings that drift over time.',
      },
      {
        title: 'How quickly can a suspended or dormant account be revived?',
        description:
          'In most cases, dormant or suspended accounts can be restored to full compliance within 1-3 weeks through a structured audit and campaign restructure.',
      },
      {
        title: 'What makes a Google Ad Grant account healthy?',
        description:
          'There is no single number we rely on. A healthy account usually comes from relevant keywords, clear ad copy, and landing pages that match what people are actually searching for.',
      },
      {
        title: 'Do I need conversion tracking to keep my Google Ad Grant active?',
        description:
          'Yes — Google requires all Ad Grant accounts to have active conversion tracking. Proper GA4 + GTM tracking measures donations, signups, and phone calls.',
      },
      {
        title: 'How much does a Google Ad Grant audit cost?',
        description:
          'The initial account audit is 100% free with zero obligation. Delivered straight to your inbox within 24-72 hours.',
      },
    ]}
  />

  <!-- Section 9: Contact & Free Audit Form -->
  <section id="contact" class="py-20 bg-[#10243E] text-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Left: Contact Details -->
        <div>
          <span class="text-[#10B981] text-sm font-semibold uppercase tracking-wider">Get In Touch</span>
          <h2 class="text-3xl md:text-4xl font-bold mt-2">Let’s make your grant easier to manage.</h2>
          <p class="text-slate-400 mt-4 leading-relaxed">
            If your account feels messy, underused, or stuck, I can help you sort the next steps. The goal is usually not more complexity — it is a clearer plan and a better use of the grant you already have.
          </p>

          <div class="mt-8 space-y-4">
            <a
              href="mailto:AcquireLift@gmail.com"
              class="flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/10 hover:bg-white/10 transition-colors"
            >
              <span class="material-symbols-outlined text-[#10B981]">mail</span>
              <div>
                <div class="font-semibold">Email Directly</div>
                <div class="text-sm text-slate-400">AcquireLift@gmail.com</div>
              </div>
            </a>

            <a
              href="https://wa.me/251927059884"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/10 hover:bg-white/10 transition-colors"
            >
              <span class="material-symbols-outlined text-[#10B981]">chat</span>
              <div>
                <div class="font-semibold">Chat on WhatsApp</div>
                <div class="text-sm text-slate-400">Quick response guaranteed</div>
              </div>
            </a>

            <a
              href="https://www.upwork.com/freelancers/~014af4bc3641ee20e9?mp_source=share"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/10 hover:bg-white/10 transition-colors"
            >
              <span class="material-symbols-outlined text-[#10B981]">work</span>
              <div>
                <div class="font-semibold">Hire on Upwork</div>
                <div class="text-sm text-slate-400">5.0 ★ · 100% Job Success</div>
              </div>
            </a>

            <a
              href="https://www.linkedin.com/in/mamae"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/10 hover:bg-white/10 transition-colors"
            >
              <span class="material-symbols-outlined text-[#10B981]">person</span>
              <div>
                <div class="font-semibold">Connect on LinkedIn</div>
                <div class="text-sm text-slate-400">/in/mamae</div>
              </div>
            </a>
          </div>
        </div>

        <!-- Right: Audit Form -->
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 shadow-xl">
          <h3 class="text-xl font-bold mb-2">Book Your Free Account Audit</h3>
          <p class="text-slate-400 text-sm mb-6">
            Fill out your details below. Audit reports are delivered to your email in 24-72 hours.
          </p>

        <!-- SUCCESS BANNER (Hidden by default, shown after AJAX submit) -->
          <div id="success-banner" class="hidden p-6 rounded-xl bg-emerald-500/20 border border-emerald-500/50 text-emerald-200">
            <div class="flex items-start space-x-3">
              <span class="text-3xl">🎉</span>
              <div>
                <h4 class="font-bold text-lg text-emerald-100">Audit Request Received!</h4>
                <p class="text-sm text-emerald-200/90 mt-1">
                  Thank you! Your audit request has been sent to AcquireLift. We will review your Ad Grant details and email your report within 24–48 hours.
                </p>
              </div>
            </div>
          </div>

          <!-- AJAX FORM -->
          <form id="audit-form" class="space-y-5">
            <input type="hidden" name="accessKey" value="sf_a846693e58821ba9394185bc" />
            <input type="hidden" name="subject" value="New Google Ad Grant Audit Request from Homepage" />
                    <input type="hidden" name="source" value="homepage-audit" />
                    <input type="text" name="honeypot" style="display:none" />

                    <div class="mb-4">
                      <label class="block text-sm font-semibold mb-2 text-gray-200">Your Name / Organization</label>
                      <input type="text" name="name" required placeholder="e.g. Hope Foundation" class="w-full px-4 py-3 rounded-lg border border-slate-700 bg-slate-800/80 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" />
                    </div>

                    <div class="mb-4">
                      <label class="block text-sm font-semibold mb-2 text-gray-200">Email* (Primary contact)</label>
                      <input type="email" name="replyTo" required placeholder="contact@yourcharity.org" class="w-full px-4 py-3 rounded-lg border border-slate-700 bg-slate-800/80 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" />
                    </div>

                    <div class="mb-4">
                      <label class="block text-sm font-semibold mb-2 text-gray-200">Organization Website URL*</label>
                      <input type="url" name="website" required placeholder="https://yourcharity.org" class="w-full px-4 py-3 rounded-lg border border-slate-700 bg-slate-800/80 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" />
                      <p class="text-xs text-slate-400 mt-1">Please enter the Organization Website URL</p>
                    </div>

                    <div class="mb-4">
                      <label class="block text-sm font-semibold mb-2 text-gray-200">Target Landing Pages (1–3 URLs)</label>
                      <textarea name="target_pages" rows="2" placeholder="e.g. https://yourcharity.org/donate" class="w-full px-4 py-3 rounded-lg border border-slate-700 bg-slate-800/80 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition"></textarea>
                    </div>

                    <fieldset class="mb-4">
                      <legend class="text-sm font-semibold mb-2 text-gray-200">Do you currently have an active Google Ad Grant?*</legend>
                      <div class="space-y-2 mt-2 text-sm text-slate-200">
                        <label><input type="radio" name="grant_status" value="active" required /> Yes, it’s active and running.</label><br />
