---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services | AcquireLift — Google Ad Grant Specialist',
  description:
    'Explore AcquireLift Google Ad Grant services for nonprofits: free audits, account recovery, setup, and monthly management.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="AcquireLift Services"
    title="Practical Google Ad Grant support for nonprofits"
    subtitle="I help charities and 501(c)(3) nonprofits make better use of their Google Ad Grant with clear setup, thoughtful audits, and steady support."
    actions={[
      {
        variant: 'primary',
        text: 'Request Free Audit',
        href: 'mailto:AcquireLift@gmail.com?subject=Google%20Ad%20Grant%20Audit%20Request',
        icon: 'tabler:mail',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'AcquireLift Ad Grant Audit Services',
    }}
  />

  <!-- Core Services Grid ************** -->

  <Features
    title="Support options built around real nonprofit needs"
    subtitle="Every service is designed to make the account easier to understand, easier to manage, and more useful for the people you want to reach."
    columns={2}
    items={[
      {
        title: '1. Account Audits (Free & Premium)',
        description:
          'In-depth review of quality scores, keyword CTRs, negative match lists, and compliance vulnerabilities. Delivered in 24-48 hours via text report.',
        icon: 'tabler:file-search',
      },
      {
        title: '2. Account Recovery & Relevance Support',
        description:
          'Practical help for accounts that need better structure, clearer policy alignment, and stronger relevance between keywords, ads, and landing pages.',
        icon: 'tabler:shield-check-filled',
      },
      {
        title: '3. Grant Application Setup',
        description:
          'Full-service assistance with TechSoup validation, Google for Nonprofits activation, and initial campaign creation.',
        icon: 'tabler:square-plus',
      },
      {
        title: '4. Monthly Campaign Management',
        description:
          'Continuous keyword expansion, compelling ad copywriting, conversion tracking optimization, and monthly performance reporting.',
        icon: 'tabler:adjustments-horizontal',
      },
    ]}
  />

  <!-- Detailed Breakdown **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Certified Google Partner Expertise',
        description:
          'We specialize strictly in Google Ad Grants for non-profits, ensuring your campaigns follow all 501(c)(3) guidelines.',
        icon: 'tabler:certificate',
      },
      {
        title: '100% Async / Text-First Workflow',
        description:
          'Save time without scheduling calls. All communication and reports are delivered clearly in writing.',
        icon: 'tabler:mail',
      },
      {
        title: 'Full $10,000/Mo Budget Utilization',
        description:
          'We leverage Smart Bidding and long-tail keyword strategies to break past the standard $2.00 manual bid cap.',
        icon: 'tabler:trending-up',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?ixlib=rb-4.0.3&auto=format&fit=crop&w=870&q=80',
      alt: 'Ad Grant Performance',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Why Non-Profits Choose AcquireLift
      </h3>
      Empowering charities to reach donors, volunteers, and beneficiaries without spending a dime on ad credits.
    </Fragment>
  </Content>

  <section class="py-16">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Service paths</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-4xl">
          Choose the service path that fits your nonprofit right now.
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <a href="/services/google-ad-grant-setup" class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#10B981] hover:shadow-lg dark:border-slate-800 dark:bg-[#10243E]">
          <h3 class="text-xl font-semibold text-[#10243E] dark:text-white">Grant Revival Launch</h3>
          <p class="mt-3 text-slate-600 dark:text-slate-300">A thoughtful setup for nonprofits launching or rebuilding a Google Ad Grant account with clarity and structure.</p>
        </a>
        <a href="/services/google-ad-grant-management" class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#10B981] hover:shadow-lg dark:border-slate-800 dark:bg-[#10243E]">
          <h3 class="text-xl font-semibold text-[#10243E] dark:text-white">Grant Growth Partner</h3>
          <p class="mt-3 text-slate-600 dark:text-slate-300">Steady management and monthly care for nonprofits that want less guesswork and more momentum.</p>
        </a>
        <a href="/services/google-ad-grant-audit" class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#10B981] hover:shadow-lg dark:border-slate-800 dark:bg-[#10243E]">
          <h3 class="text-xl font-semibold text-[#10243E] dark:text-white">Grant Health Audit</h3>
          <p class="mt-3 text-slate-600 dark:text-slate-300">A text-first audit for compliance, account relevance, tracking, and clear next steps.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email AcquireLift@gmail.com',
        href: 'mailto:AcquireLift@gmail.com?subject=Google%20Ad%20Grant%20Audit%20Request',
        icon: 'tabler:mail',
      },
    ]}
    title="Ready to Maximize Your $10,000/Mo Ad Grant?"
    subtitle="Email us today for your free, text-based account audit delivered in 24-48 hours."
  />
</Layout>
