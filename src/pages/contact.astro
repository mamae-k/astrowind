---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact | AcquireLift',
  description:
    'Contact AcquireLift for non-profit Google Ad Grant audits and management. Async and email-first communication model.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget -->
  <HeroText tagline="Contact AcquireLift" title="Fast, Async Email Communication" />

  <!-- Features2 Widget -->
  <Features2
    title="Get In Touch with AcquireLift"
    subtitle="We operate on a 100% text-first and async model. This respects your time and allows us to deliver well-researched audit reports with actionable screenshots."
    columns={2}
    items={[
      {
        title: 'Direct Email',
        description: 'AcquireLift@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Audit Turnaround',
        description: 'Fast delivery within 24-48 hours',
        icon: 'tabler:clock',
      },
      {
        title: 'Credentials',
        description: 'Certified Google Partner & 5-Star Upwork Specialist',
        icon: 'tabler:certificate',
      },
      {
        title: 'Target Audience',
        description: 'Non-profit directors, founders, and charity marketing heads',
        icon: 'tabler:heart-handshake',
      },
    ]}
  />

  <!-- THIS COMPONENT LOADS YOUR Form.astro FILE WITH STATICFORMS -->
  <ContactUs
    title="Request Your Free Google Ad Grant Audit"
    subtitle="Fill out the form below to receive a comprehensive, text-based account review."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
        placeholder: 'Jane Doe',
      },
      {
        type: 'email',
        name: 'replyTo',
        label: 'Non-Profit Email',
        placeholder: 'jane@yourcharity.org',
      },
      {
        type: 'text',
        name: 'website',
        label: 'Non-Profit Website URL',
        placeholder: 'https://yourcharity.org',
      },
    ]}
    textarea={{
      label: 'Ad Grant Details / Message',
      placeholder: 'Tell us about your Ad Grant account status or compliance issues...',
    }}
    button="Submit Audit Request →"
  />

  <!-- CallToAction Widget -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email AcquireLift@gmail.com',
        href: 'mailto:AcquireLift@gmail.com?subject=Google%20Ad%20Grant%20Audit%20Request',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
    title="Prefer Direct Email?"
    subtitle="Email us your website URL or Google Ads Customer ID today to get started."
  />
</Layout>