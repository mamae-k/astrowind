---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Google Ad Grant Conversion Tracking | AcquireLift',
  description:
    'A practical introduction to conversion tracking for nonprofits using Google Ad Grants.',
};
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Starter cluster article</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          Google Ad Grant conversion tracking: why nonprofits need to measure the right actions.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Tracking matters because it tells you whether your grant is generating meaning, not just clicks. For nonprofits, that often means donations, newsletter signups, volunteer enquiries, or service requests.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">What to measure</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            <li>• Donations and donation confirmation paths</li>
            <li>• Volunteer signups or programme enquiries</li>
            <li>• Contact form submissions and important follow-up actions</li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Related resources</h2>
          <ul class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <li><a href="/resources/grant-ready-website-checklist" class="font-medium text-primary dark:text-[#10B981]">Grant-ready website checklist</a></li>
            <li><a href="/services/google-ad-grant-setup" class="font-medium text-primary dark:text-[#10B981]">Setup service</a></li>
            <li><a href="/services/google-ad-grant-management" class="font-medium text-primary dark:text-[#10B981]">Management service</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Want a clearer view of what your grant is actually driving?"
    subtitle="A strong tracking setup makes it easier to understand which campaigns, pages, and messages are creating momentum."
    actions={[
      {
        variant: 'primary',
        text: 'Request Your Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
