---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Google Ad Grant Approval Checklist | AcquireLift',
  description:
    'A practical checklist for nonprofits preparing for the Google Ad Grant application and approval process.',
};
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Starter cluster article</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          Google Ad Grant approval checklist for nonprofits.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Approval is not just about completing the application. It is also about showing that your organization is prepared to use the grant with clear purpose and a credible website experience.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Checklist focus areas</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            <li>• Confirm your organization status and account access readiness</li>
            <li>• Prepare a credible website with useful calls to action</li>
            <li>• Review your messaging before you launch campaigns</li>
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Related resources</h2>
          <ul class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <li><a href="/resources/google-ad-grant-eligibility" class="font-medium text-primary dark:text-[#10B981]">Eligibility guide</a></li>
            <li><a href="/resources/grant-ready-website-checklist" class="font-medium text-primary dark:text-[#10B981]">Grant-ready website checklist</a></li>
            <li><a href="/services/google-ad-grant-setup" class="font-medium text-primary dark:text-[#10B981]">Setup service</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Need help turning your approval prep into an operational launch plan?"
    subtitle="I can help you move from application readiness into a stronger account structure and website experience."
    actions={[
      {
        variant: 'primary',
        text: 'Request Your Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
