---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Grant-Ready Website Checklist | AcquireLift',
  description:
    'A nonprofit website checklist for supporting Google Ad Grants, improving trust, and increasing conversion quality.',
};

const checklist = [
  'Clear value proposition near the top of the page',
  'Fast loading times and mobile-friendly layout',
  'Strong donation, volunteer, or contact paths that are easy to find',
  'Trust signals such as mission statement, impact stories, and contact details',
  'Simple navigation with clear calls to action',
  'Conversion tracking connected to the key actions you care about',
];
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Supporting resource</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          A nonprofit website checklist for Google Ad Grants.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Even a very good grant account can underperform if the website is unclear, slow, or disconnected from the promise made in the ad.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[1.3fr_0.9fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">What a grant-ready website usually includes</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            {checklist.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 text-[#10B981]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
            <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Why this matters</h2>
            <p class="mt-3 text-slate-600 dark:text-slate-300">
              Your ad can attract the right audience, but the website determines whether that audience feels confident enough to take action.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
            <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Related reading</h2>
            <ul class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
              <li>
                <a href={getPermalink('/resources/google-ad-grants-guide')} class="font-medium text-primary dark:text-[#10B981]">
                  The Complete Google Ad Grants Guide
                </a>
              </li>
              <li>
                <a href={getPermalink('/services')} class="font-medium text-primary dark:text-[#10B981]">
                  Google Ad Grant services
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Want a practical review of your nonprofit website and ad account?"
    subtitle="I can review both the website experience and the grant setup so the next step is clearer and more strategic."
    actions={[
      {
        variant: 'primary',
        text: 'Request Your Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
