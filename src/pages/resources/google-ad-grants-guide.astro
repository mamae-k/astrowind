---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'The Complete Google Ad Grants Guide | AcquireLift',
  description:
    'A nonprofit-friendly guide to Google Ad Grants, from eligibility and approval to compliance, CTR, landing pages, and optimization.',
};

const sections = [
  {
    title: '1. What the Google Ad Grant is',
    text: 'The Google Ad Grant gives eligible nonprofits up to $10,000 per month in free search advertising credit. It is most valuable when the account is structured around mission-driven keywords and a website that can convert visitors into donors, volunteers, or beneficiaries.',
  },
  {
    title: '2. Why many nonprofits lose momentum',
    text: 'Accounts often fail because the strategy is too broad, the account is poorly structured, or the website cannot support the intent behind the ad. The strongest accounts combine compliant keywords, clear messaging, and a landing experience built for action.',
  },
  {
    title: '3. What good account setup looks like',
    text: 'A strong setup starts with tightly themed ad groups, high-intent keywords, quality ad copy, conversion tracking, and a simple path from search query to meaningful action. The goal is to make every click relevant, every page useful, and every action measurable.',
  },
  {
    title: '4. Why CTR and compliance matter',
    text: 'Google expects accounts to stay active, relevant, and useful. A healthy CTR, realistic keywords, and compliant landing pages reduce the risk of account issues while improving the chance that the grant is used well.',
  },
];
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Pillar guide</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          The Complete Google Ad Grants Guide for nonprofits.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          This guide is meant to be the starting point for nonprofits that want to understand Google Ad Grants clearly and use the grant more strategically.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[1.5fr_0.9fr]">
        <div class="space-y-6">
          {sections.map((section) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
              <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">{section.title}</h2>
              <p class="mt-3 text-slate-600 dark:text-slate-300">{section.text}</p>
            </div>
          ))}
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
            <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Related resources</h2>
            <ul class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
              <li>
                <a href={getPermalink('/resources/grant-ready-website-checklist')} class="font-medium text-primary dark:text-[#10B981]">
                  Grant-ready website checklist
                </a>
              </li>
              <li>
                <a href={getPermalink('/services')} class="font-medium text-primary dark:text-[#10B981]">
                  See the services offered
                </a>
              </li>
              <li>
                <a href={getPermalink('/#contact')} class="font-medium text-primary dark:text-[#10B981]">
                  Request a free audit
                </a>
              </li>
            </ul>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
            <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">What this guide covers</h2>
            <ul class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
              <li>• Eligibility and practical expectations</li>
              <li>• Compliance and policy awareness</li>
              <li>• CTR, keywords, and account structure</li>
              <li>• Website readiness and conversion tracking</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 dark:bg-[#0F172A]/50">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
        <h2 class="text-2xl font-semibold text-[#10243E] dark:text-white">How to use this guide</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="font-semibold text-[#10243E] dark:text-white">Start with the strategy</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Read the guide to understand what a healthy grant account should look like before you change anything inside Google Ads.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#10243E] dark:text-white">Then build the support system</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Make sure the website is ready to convert attention into donations, form fills, volunteer signups, or other mission outcomes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Not sure whether your nonprofit is using the grant well?"
    subtitle="Request a free text-based audit and I will review your account and website approach with practical recommendations."
    actions={[
      {
        variant: 'primary',
        text: 'Request Your Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
