---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Resources | AcquireLift',
  description:
    'Practical resources for nonprofits using Google Ad Grants, building better websites, and making their accounts easier to understand.',
};

const resources = [
  {
    title: 'The Complete Google Ad Grants Guide',
    description:
     'A straightforward guide to Google Ad Grants, from eligibility and setup to compliance, relevance, and long-term account health.',
    href: getPermalink('/resources/google-ad-grants-guide'),
  },
  {
    title: 'Grant-Ready Website Checklist',
    description:
     'A practical checklist for the website basics that help your grant account feel more useful, more trustworthy, and easier to act on.',
    href: getPermalink('/resources/grant-ready-website-checklist'),
  },
  {
    title: 'Google Ad Grant Eligibility',
    description:
     'A plain-English guide to the nonprofit questions and account readiness issues that shape eligibility.',
    href: getPermalink('/resources/google-ad-grant-eligibility'),
  },
  {
    title: 'Google Ad Grant Approval Checklist',
    description:
     'A practical checklist for nonprofits preparing for the grant application and early launch stage without overcomplicating the process.',
    href: getPermalink('/resources/google-ad-grant-approval-checklist'),
  },
  {
   title: 'Google Ad Grant Relevance Checks',
    description:
     'A simple overview of why relevance matters and how to keep your account healthier through better keywords, ads, and landing pages.',
    href: getPermalink('/resources/google-ad-grant-ctr-requirements'),
  },
  {
    title: 'Google Ad Grant Conversion Tracking',
    description:
     'A useful starting point for nonprofits that want to measure donations, signups, and other meaningful outcomes from their grant account.',
    href: getPermalink('/resources/google-ad-grant-conversion-tracking'),
  },
];
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Practical resources</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          A calmer, more useful place to learn about Google Ad Grants.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          These pages are meant to help nonprofits make better decisions without overcomplicating the process. They are practical,
          straightforward, and built around the next step that matters most.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {resources.map((resource) => (
          <a
            href={resource.href}
            class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-[#10B981] hover:shadow-lg dark:border-slate-800 dark:bg-[#10243E]"
          >
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#10B981]/10 text-[#10B981]">
              <span class="text-xl">↗</span>
            </div>
            <h2 class="mt-6 text-2xl font-semibold text-[#10243E] dark:text-white">{resource.title}</h2>
            <p class="mt-3 text-slate-600 dark:text-slate-300">{resource.description}</p>
            <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-[#10B981]">
              Read the guide
              <span class="transition group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 dark:bg-[#0F172A]/50">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
        <h2 class="text-2xl font-semibold text-[#10243E] dark:text-white">Why this section exists</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          <div>
            <h3 class="font-semibold text-[#10243E] dark:text-white">Built around clarity</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              The goal is simple: make it easier for nonprofits to understand what matters and what should be fixed first.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#10243E] dark:text-white">Designed for action</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Each page points readers toward a practical next step, whether that is a stronger website, better tracking, or a free audit.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#10243E] dark:text-white">Focused on real needs</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              The content stays centered on Google Ad Grants because that is where the most useful guidance usually begins.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Need a more strategic Google Ad Grant setup?"
    subtitle="If your nonprofit wants a practical audit, a stronger account structure, or better conversion tracking, I can help."
    actions={[
      {
        variant: 'primary',
        text: 'Request Your Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
