---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Grant Revival Launch | AcquireLift',
  description:
    'A warm, thoughtful Google Ad Grant setup service for nonprofits that want a stronger foundation from day one.',
};

const deliverables = [
  'A practical review of your account access, nonprofit eligibility, and early setup needs',
  'Keyword and campaign structure built around mission-driven intent and clear user needs',
  'Ad copy and landing page alignment so the grant feels more relevant from the start',
  'Conversion tracking for donations, volunteer signups, contact forms, and other meaningful actions',
];
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Service page</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          Grant Revival Launch: a stronger start for nonprofits building or rebuilding their Google Ad Grant.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Whether you are launching a new grant account or repairing one that has been sitting idle, this service helps you begin with clarity, compliance, and a structure that supports your mission from the first click.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/#contact" class="rounded-full bg-[#10B981] px-5 py-3 font-semibold text-white transition hover:bg-[#0f9f6f]">
            Book Free Audit
          </a>
          <a href="/resources/google-ad-grants-guide" class="rounded-full border border-slate-300 px-5 py-3 font-semibold text-[#10243E] transition hover:border-[#10B981] hover:text-[#10B981] dark:border-slate-700 dark:text-white">
            Read the guide
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-[1.15fr_0.85fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">What this setup service includes</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            {deliverables.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 text-[#10B981]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Best for nonprofits that want to:</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            <li>• Launch with a stronger structure from day one</li>
            <li>• Avoid common mistakes that lead to low-quality traffic</li>
            <li>• Connect the grant to fundraising, volunteer support, or awareness goals</li>
          </ul>
        </div>
      </div>

      <div class="mt-10 rounded-3xl border border-[#10B981]/20 bg-[#F8FAFC] p-8 shadow-sm dark:bg-[#0F172A]/50">
        <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">A few results that reflect what strong nonprofit grant setups can achieve</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          <div>
            <p class="text-3xl font-bold text-[#10B981]">3 → 40+</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Clicks per day after a stronger structure was put in place</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#10B981]">1,200%</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Traffic lift achieved in a rebuilt, more relevant account</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#10B981]">Cleaner structure</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">A stronger account foundation makes it easier to review, maintain, and improve over time</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Ready to get your Google Ad Grant started the right way?"
    subtitle="Book a free audit and I will help you see what needs attention first, with practical recommendations you can act on right away."
    actions={[
      {
        variant: 'primary',
        text: 'Book Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
