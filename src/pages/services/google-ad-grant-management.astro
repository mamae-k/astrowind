---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Grant Growth Partner | AcquireLift',
  description:
    'A warm, steady Google Ad Grant management service for nonprofits that want less guesswork and more momentum.',
};

const focusAreas = [
  'Regular keyword and search term review so the account stays relevant and useful',
  'Ad copy updates and landing page alignment to strengthen the user experience',
  'CTR and account health monitoring so bigger issues are spotted early',
  'Monthly reporting with clear next steps for your team and leadership',
];
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Service page</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          Grant Growth Partner: steady Google Ad Grant management for nonprofits that want momentum without the overwhelm.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Ongoing management helps your account stay healthy, relevant, and useful. It is a good fit for nonprofits that want someone to guide the day-to-day decisions behind the grant while keeping the work clear, calm, and focused on mission impact.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/#contact" class="rounded-full bg-[#10B981] px-5 py-3 font-semibold text-white transition hover:bg-[#0f9f6f]">
            Book Free Audit
          </a>
          <a href="/resources/google-ad-grant-ctr-requirements" class="rounded-full border border-slate-300 px-5 py-3 font-semibold text-[#10243E] transition hover:border-[#10B981] hover:text-[#10B981] dark:border-slate-700 dark:text-white">
            Learn about relevance checks
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-[1.15fr_0.85fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Management focus areas</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            {focusAreas.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 text-[#10B981]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Ideal for nonprofits that need help with:</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            <li>• Ongoing campaign optimization and maintenance</li>
            <li>• Better account hygiene and fewer wasted clicks</li>
            <li>• A clearer reporting rhythm for internal stakeholders</li>
          </ul>
        </div>
      </div>

      <div class="mt-10 rounded-3xl border border-[#10B981]/20 bg-[#F8FAFC] p-8 shadow-sm dark:bg-[#0F172A]/50">
        <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">What good ongoing management looks like in practice</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          <div>
            <p class="text-3xl font-bold text-[#10B981]">65%</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Increase in high-value conversions when the account is guided by stronger tracking and tighter focus</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#10B981]">80/20</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">A practical reminder that a small set of strong keywords and pages can drive the majority of results</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#10B981]">8/10</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Quality Score performance that signals better relevance and stronger account health</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Want a more consistent Google Ad Grant management rhythm?"
    subtitle="Book a free audit and I will help you see what your account needs next, with a practical plan for steady improvement."
    actions={[
      {
        variant: 'primary',
        text: 'Book Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
