---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Grant Health Audit | AcquireLift',
  description:
    'A warm, text-first Google Ad Grant audit for nonprofits that want clarity around compliance, CTR health, tracking, and account structure.',
};

const auditPoints = [
  'A careful review of account structure, keyword relevance, and campaign clarity',
  'A CTR and search term quality check to spot where the account may be drifting',
  'A landing page and conversion tracking review to see whether the account is leading to meaningful outcomes',
  'A clear list of practical recommendations so you know what to fix first',
];
---

<Layout metadata={metadata}>
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary dark:text-[#10B981]">Service page</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#10243E] dark:text-white sm:text-5xl">
          Grant Health Audit: a clear, text-first review for nonprofits that want a practical next step.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Whether your account is underperforming, inactive, or simply unclear, a thoughtful audit can help you understand what is holding it back and what should be improved first. This is especially helpful when you want a calm, straightforward review without a lot of meeting overhead.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/#contact" class="rounded-full bg-[#10B981] px-5 py-3 font-semibold text-white transition hover:bg-[#0f9f6f]">
            Book Free Audit
          </a>
          <a href="/resources/google-ad-grant-approval-checklist" class="rounded-full border border-slate-300 px-5 py-3 font-semibold text-[#10243E] transition hover:border-[#10B981] hover:text-[#10B981] dark:border-slate-700 dark:text-white">
            Review the checklist
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-[1.15fr_0.85fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-[#10243E]">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">What the audit typically covers</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            {auditPoints.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 text-[#10B981]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-[#0F172A]/60">
          <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Best for nonprofits that need to:</h2>
          <ul class="mt-6 space-y-3 text-slate-600 dark:text-slate-300">
            <li>• Understand why traffic is low or inconsistent</li>
            <li>• Identify compliance or account health issues</li>
            <li>• Prioritize the next steps in a clear order</li>
          </ul>
        </div>
      </div>

      <div class="mt-10 rounded-3xl border border-[#10B981]/20 bg-[#F8FAFC] p-8 shadow-sm dark:bg-[#0F172A]/50">
        <h2 class="text-xl font-semibold text-[#10243E] dark:text-white">Examples of the kinds of improvements an audit can surface</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          <div>
            <p class="text-3xl font-bold text-[#10B981]">3 → 40+</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Clicks per day after a dormant account was revived with a stronger structure</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#10B981]">Clearer priorities</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">An audit helps surface what matters most so the next steps feel manageable and practical</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#10B981]">30%</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Lower cost per conversion when the account is aligned around stronger intent and messaging</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Ready for a practical Google Ad Grant review?"
    subtitle="Book a free audit and I will help you see what your account needs next, with recommendations you can act on right away."
    actions={[
      {
        variant: 'primary',
        text: 'Book Free Audit',
        href: '/#contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
